# Base MySQL (en local : conteneur Docker du docker-compose, port 3307)
DATABASE_URL="mysql://root:motdepasse@localhost:3307/pointage_pad"
# Longue chaine aleatoire (32 caracteres et plus)
JWT_SECRET="remplacer-par-une-longue-chaine-aleatoire"
# WebAuthn : nom de domaine et URL exacte de l'application (https en production)
RP_ID="localhost"
ORIGIN="http://localhost:5173"
# Proxys de confiance devant l'API : 0 en acces direct, 1 derriere Nginx. Jamais plus.
TRUST_PROXY="0"
# Valeurs initiales de la zone (modifiables ensuite dans l'ecran Zone de pointage)
ALLOWED_IPS="127.0.0.1,::1"
ZONE_LAT="4.0483"
ZONE_LNG="9.6958"
ZONE_RADIUS="150"
# Mot de passe du compte ADMIN cree par `npm run seed` (8 caracteres minimum, obligatoire)
ADMIN_PASSWORD=""
PORT="4000"
# Production : dossier de l'interface compilee, servie par l'API
CLIENT_DIST=""
